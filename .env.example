# ─────────────────────────────────────────────────────────────────────────────
# Odoo connection — copy this file to .env and fill in your values
# These are read SERVER-SIDE only (Vercel function / Vite dev proxy).
# They are NEVER exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Odoo instance URL (no trailing slash)
VITE_ODOO_URL=https://adage-automation.odoo.com

# Database name — same as the subdomain
VITE_ODOO_DB=adage-automation.odoo.com

# Login email of the Odoo user
VITE_ODOO_LOGIN=adarsh@adage-automation.com

# Authentication — use ONE of the following:
# Option A (recommended): API key — generate in Odoo → Settings → Technical → API Keys
VITE_ODOO_API_KEY=e74cb3b028475c1a982d11617c26a012818eed3b
# Option B: Account password
# VITE_ODOO_PASSWORD=your_odoo_password_here

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft sign-in (Azure AD / Entra ID) — gates access to the dashboard.
# These are PUBLIC client identifiers, safe to expose in the browser bundle.
# See README.md "Microsoft sign-in setup" for how to get these values.
# ─────────────────────────────────────────────────────────────────────────────
VITE_MICROSOFT_CLIENT_ID=your-azure-app-client-id
VITE_MICROSOFT_TENANT_ID=your-azure-tenant-id
